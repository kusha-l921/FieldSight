# ==========================================
# 3. Datasets, Heavy Media & Model Weights
# ==========================================
# Bulk raw vision datasets (keep directory hierarchy via .gitkeep)
data/raw/*
!data/raw/.gitkeep

# Evaluation archives & compressed dataset packages
*.zip
*.tar
*.tar.gz
*.tgz
*.gz
*.bz2
*.xz
*.7z
*.rar

# Model checkpoints & serialized weights
*.pt
*.pth
*.onnx
*.tflite
*.h5
*.pkl
*.pickle
*.joblib
*.ckpt
*.safetensors
*.engine
*.weights

# Preserve lightweight committed sample test images
!samples/
!samples/**

# ==========================================
# 4. Databases, Runtime Persistence & Logs
# ==========================================
# Active SQLite progression database files (keep directory hierarchy via .gitkeep)
data/temporal_db/*.db
*.sqlite
*.sqlite3
*.db
*.db-journal
*.db-wal
*.db-shm
!data/temporal_db/.gitkeep

# Application & execution logs
*.log
logs/

# ==========================================
# 5. Output Artifacts & Benchmark Plots
# ==========================================
# Ephemeral run & batch output artifacts
batch_outputs/
outputs/
runs/

# Generated benchmark plots & figures (keep directory via .gitkeep)
results/plots/*.png
results/plots/*.jpg
results/plots/*.jpeg
results/plots/*.svg
results/plots/*.pdf
!results/plots/.gitkeep

# ==========================================
# 6. Streamlit, Dashboards & Jupyter Notebooks
# ==========================================
# Streamlit credentials & secrets (track config.toml for custom UI themes)
.streamlit/secrets.toml
.streamlit/credentials.toml

# Jupyter / IPython checkpoints & caches
.ipynb_checkpoints/
*-checkpoint.ipynb
.jupyter/

